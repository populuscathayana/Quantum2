# Public repository allowlist; working archives and cluster tooling stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ENVIRONMENT.md
!/POSTPROCESS.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/requirements.txt
!/reproduce.py

!/data/
/data/*
!/data/manifest.json
!/data/calculations/
/data/calculations/**/*
!/data/calculations/**/
!/data/calculations/**/*.gjf
!/data/calculations/**/*.out
!/data/calculations/**/*.fchk

!/scripts/
/scripts/*
!/scripts/gaussian_io.py
!/scripts/figure_fonts.py
!/scripts/export_tables.py
!/scripts/verify_public_data.py
!/scripts/compare_properties.py
!/scripts/compare_experiment.py
!/scripts/plot_spectra.R
!/scripts/plot_comparison.R
!/scripts/plot_experiment.R
!/scripts/render_stage1_structures.py
!/scripts/render_orbitals.py
!/scripts/test_experiment.py
!/scripts/check_report.py

!/analysis/
/analysis/*
!/analysis/stage1/
/analysis/stage1/*
!/analysis/stage1/audit.json
!/analysis/stage1/*-optimized.xyz
!/analysis/stage1/optimized-structures.png
!/analysis/stage2/
/analysis/stage2/*
!/analysis/stage2/*.csv
!/analysis/stage2/*.png
!/analysis/stage2/*.pdf
!/analysis/stage2/verified-results.json
!/analysis/stage2/orbital-validation.json
!/analysis/conf01/
/analysis/conf01/*
!/analysis/conf01/*.csv
!/analysis/conf01/verified-results.json
!/analysis/dimers/
/analysis/dimers/**/*
!/analysis/dimers/**/
!/analysis/dimers/**/audit.json
!/analysis/dimers/**/optimized.xyz
!/analysis/dimer-properties/
/analysis/dimer-properties/**/*
!/analysis/dimer-properties/**/
!/analysis/dimer-properties/**/*.csv
!/analysis/dimer-properties/**/verified-results.json
!/analysis/comparison/
!/analysis/experimental/

!/references/
/references/*
!/references/experimental/
/references/experimental/*
!/references/experimental/nmr-h-reference.json
!/references/experimental/nmr-c-reference.json
!/references/experimental/nmr-j-reference.json
!/references/experimental/uv-reference-points.csv
!/references/experimental/uv-reference.json

!/experiment-report/
/experiment-report/*
!/experiment-report/sorbic_acid_uv_nmr.tex
!/experiment-report/sorbic_acid_uv_nmr.pdf

# Never include runtime credentials, checkpoints, archives or build products.
.DS_Store
__pycache__/
*.pyc
.venv/
.env
.env.*
*.pem
*.key
*.chk
*.rwf
*.int
*.d2e
*.tar.gz
slurm-*.out
submitted.jobid
.submission-lock/
